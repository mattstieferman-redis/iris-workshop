# ===================================================
#  YOU FILL THESE IN
# ===================================================

# Active domain: reddash | electrohub | finance-researcher | healthcare | radish-bank | rmobile
DEMO_DOMAIN=reddash

# OpenAI
OPENAI_API_KEY=

# Redis Cloud database
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_SSL=false

# Context Surfaces (admin key from cloud console)
CTX_ADMIN_KEY=

# Agent Memory
MEMORY_API_BASE_URL=
MEMORY_STORE_ID=
MEMORY_API_KEY=

# LangCache
LANGCACHE_HOST=
LANGCACHE_CACHE_ID=
LANGCACHE_API_KEY=

# ===================================================
#  AUTO-POPULATED (by make setup)
# ===================================================

MCP_AGENT_KEY=
CTX_SURFACE_ID=
DEMO_USER_ID=
DEMO_USER_NAME=
DEMO_USER_EMAIL=

# ===================================================
#  DEFAULTS (change only if needed)
# ===================================================

OPENAI_CHAT_MODEL=gpt-4o

# Chat model provider for the agent: openai (default) or anthropic (Claude).
# Embeddings (guardrail, tool routing, Simple RAG) still use OpenAI.
LLM_PROVIDER=openai
# Optional model override, e.g. claude-sonnet-5-5 (Claude API) or anthropic.claude-sonnet-5-5 (Bedrock).
LLM_MODEL=
LLM_LIGHTWEIGHT_MODEL=
# For LLM_PROVIDER=anthropic. On Amazon Bedrock, set ANTHROPIC_API_KEY to a Bedrock bearer token and
# ANTHROPIC_BASE_URL to https://bedrock-mantle.<region>.api.aws/anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
REDIS_USERNAME=default
REDIS_DB=0
# Optional override. When unset, all domains use 0.3: this memory service scores natural-language
# matches low (a saved allergy only matches allergy questions at 0.3 or below; 0.5 matched nothing).
# MEMORY_SIMILARITY_THRESHOLD=0.3
MEMORY_LIMIT=6
LANGCACHE_THRESHOLD=0.9
# Semantic tool routing: send the LLM only the tools each question needs (saves tokens).
# Set to false to compare token usage with every tool attached.
TOOL_ROUTING_ENABLED=true
BACKEND_PORT=8040
FRONTEND_PORT=3040
