# ===================================================
#  YOU FILL THESE IN
# ===================================================

# Active domain: reddash | electrohub | finance-researcher | healthcare | radish-bank | rmobile
DEMO_DOMAIN=reddash

# Claude (the agent's model). Use a Claude API key, or a key for any Claude-compatible endpoint.
# Amazon Bedrock: set ANTHROPIC_API_KEY to a Bedrock bearer token and ANTHROPIC_BASE_URL to
# https://bedrock-mantle.<region>.api.aws/anthropic (the region your token was minted in), and set
# LLM_MODEL to a Bedrock model ID such as anthropic.claude-sonnet-5-5.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# Redis Cloud database
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_SSL=false

# Context Surfaces (admin key from cloud console)
CTX_ADMIN_KEY=

# Agent Memory
MEMORY_API_BASE_URL=
MEMORY_STORE_ID=
MEMORY_API_KEY=

# LangCache
LANGCACHE_HOST=
LANGCACHE_CACHE_ID=
LANGCACHE_API_KEY=

# ===================================================
#  AUTO-POPULATED (by make setup)
# ===================================================

MCP_AGENT_KEY=
CTX_SURFACE_ID=
DEMO_USER_ID=
DEMO_USER_NAME=
DEMO_USER_EMAIL=

# ===================================================
#  DEFAULTS (change only if needed)
# ===================================================

# Claude model ID. Leave empty for the default (claude-sonnet-5-5 on the Claude API). On Bedrock use the
# Bedrock ID, e.g. anthropic.claude-sonnet-5-5 or anthropic.claude-haiku-4-5.
LLM_MODEL=
# Cheaper model for answer verification (defaults to LLM_MODEL).
LLM_LIGHTWEIGHT_MODEL=

# Embeddings run locally (no API key). The guardrail, tool routing, Simple RAG and the seeded
# documents all use this model. If you change it, set EMBEDDING_DIM to match, then run
# `make generate-models` and `make setup`. Distance thresholds in the domain files were tuned for the default.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
REDIS_USERNAME=default
REDIS_DB=0
# Optional override. When unset, all domains use 0.3: this memory service scores natural-language
# matches low (a saved allergy only matches allergy questions at 0.3 or below; 0.5 matched nothing).
# MEMORY_SIMILARITY_THRESHOLD=0.3
MEMORY_LIMIT=6
LANGCACHE_THRESHOLD=0.9
# Semantic tool routing: send the LLM only the tools each question needs (saves tokens).
# Set to false to compare token usage with every tool attached.
TOOL_ROUTING_ENABLED=true
BACKEND_PORT=8040
FRONTEND_PORT=3040
